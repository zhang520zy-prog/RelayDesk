{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RelayDesk",
  "version": "3.20.3",
  "identifier": "com.relaydesk.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "titleBarStyle": "Overlay",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self' 'sha256-i3GPjo0H4XEXHPTTy1BQdzo8lOqx0894sIY/DRCQaFk='; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "../THIRD_PARTY_LICENSES.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "template": "wix/per-user-main.wxs"
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["relaydesk"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3NjA0OENEM0M1Q0JFQTQKUldTa3Zsdzh6VWhnSjMxWDB2WkRzN1hmQkpUSzBGQ0xQS1VoZ2JWMkZlRVpEN3cvWGJ2ZHBSWjQK",
      "endpoints": [
        "https://github.com/zhang520zy-prog/RelayDesk/releases/download/test-build/latest.json"
      ]
    }
  }
}
