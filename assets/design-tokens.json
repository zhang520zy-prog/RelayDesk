    "light": {
      "shadowSm": { "value": "0 2px 5px rgb(25 62 47 / 4%)" },
      "shadowMd": { "value": "0 8px 28px rgb(25 62 47 / 6%)" },
      "shadowLg": { "value": "0 24px 64px rgb(12 42 31 / 16%)" },
      "insetHighlight": { "value": "inset 0 1px 0 rgb(255 255 255 / 94%)" },
      "glass": { "value": "rgb(255 255 255 / 82%)" },
      "glassLine": { "value": "rgb(255 255 255 / 94%)" },
      "sidebarGlass": { "value": "rgb(238 246 242 / 90%)" }
    },
    "dark": {
      "shadowSm": { "value": "0 2px 5px rgb(0 0 0 / 12%)" },
      "shadowMd": { "value": "0 8px 28px rgb(0 0 0 / 14%)" },
      "shadowLg": { "value": "0 24px 64px rgb(0 0 0 / 36%)" },
      "insetHighlight": { "value": "inset 0 1px 0 rgb(196 242 215 / 9%)" },
      "glass": { "value": "rgb(25 42 35 / 86%)" },
      "glassLine": { "value": "rgb(196 242 215 / 9%)" },
      "sidebarGlass": { "value": "rgb(20 34 29 / 92%)" }
    }
  },
  "component": {
    "sidebar": {
      "background": { "value": "{color.semantic.light.sidebar}" },
      "width": { "value": "expanded/collapsed via --rd-nav-* in brand.css" }
    },
    "targetCard": {
      "border": { "value": "1px solid {color.semantic.light.line}" },
      "radius": { "value": "{radius.panel}" },
      "focusState": { "value": "border {color.semantic.light.teal} + color-mix ring" }
    },
    "targetQuickBarChip": {
      "states": {
        "enabled": { "value": "default surface styling" },
        "synced": { "value": "{color.semantic.light.success} border+8% wash" },
        "failed": { "value": "{color.semantic.light.danger} border+8% wash" },
        "pending": { "value": "{color.semantic.light.warning} border+8% wash" },
        "disabled": { "value": "muted" }
      }
    },
    "sessionItem": {
      "selected": { "value": "background {color.semantic.light.soft}, border teal" }
    }
  },
  "policy": {
    "icons": "lucide-react in src/relaydesk/**; legacy @/components ProviderIcon only in legacy surfaces",
    "statusSemantics": "success/synced=green, warning/pending=amber, danger/failed=red, muted=disabled",
    "accessibility": "2px var(--rd-focus) focus ring, aria-current for selection, role=status for spinners, honor prefers-reduced-motion"
  }
}
