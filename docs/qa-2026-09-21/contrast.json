{
  "date": "2026-09-21",
  "source": "src/relaydesk/design/tokens.css",
  "algorithm": {
    "name": "WCAG 2 relative luminance contrast",
    "variableResolution": "Recursively resolve var(--token) using :root and then :root.dark overrides; convert CSS HSL to sRGB.",
    "linearChannel": "channel/12.92 for channel <= 0.04045; ((channel + 0.055) / 1.055)^2.4 otherwise",
    "luminance": "0.2126*R + 0.7152*G + 0.0722*B",
    "contrast": "(max(L1,L2)+0.05)/(min(L1,L2)+0.05)",
    "thresholds": {
      "normalText": 4.5,
      "essentialGraphics": 3.0
    },
    "alpha": "Placeholder opacity is composited in sRGB over its opaque input surface before contrast calculation.",
    "precision": "Ratios rounded to 3 decimals after comparisons; minimum overflow palette is sampled at each integer hue from 0 through 359."
  },
  "scope": [
    "Solid chart-card background resolves to --rd-surface; legend background resolves to --rd-raised.",
    "These calculations verify foreground/background contrast, not pairwise color discrimination or color-vision-deficiency perception.",
    "Glass/canvas gradients, antialiased pixels and complete native window rendering require separate visual acceptance.",
    "Chart colors on the raised legend background are graphical swatches; model labels and values use neutral text tokens.",
    "Overflow palette graph colors do not all meet normal-text contrast. All three chart Tooltips explicitly use --rd-text for item text instead of inheriting series colors."
  ],
